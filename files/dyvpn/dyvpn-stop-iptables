#!/bin/sh
set -eu
CHAIN=${DYVPN_CHAIN:-DYVPN_XRAY}
IPTABLES=${IPTABLES:-/run/current-system/profile/sbin/iptables}
if [ ! -x "$IPTABLES" ]; then
  IPTABLES=$(command -v iptables || true)
fi
if [ -z "$IPTABLES" ] || [ ! -x "$IPTABLES" ]; then
  echo "iptables not found; nothing to clean" >&2
  exit 0
fi
sudo "$IPTABLES" -t nat -D OUTPUT -p tcp -j "$CHAIN" 2>/dev/null || true
sudo "$IPTABLES" -t nat -F "$CHAIN" 2>/dev/null || true
sudo "$IPTABLES" -t nat -X "$CHAIN" 2>/dev/null || true
echo "Cleaned iptables nat chain $CHAIN"
