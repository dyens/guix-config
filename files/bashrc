# Подключается из home/base.scm через home-bash-service-type.
# Правится ЗДЕСЬ, а не в ~/.bashrc — тот станет симлинком в /gnu/store
# и будет read-only.

# Guix профили в PATH
[ -f "$HOME/.guix-profile/etc/profile" ] && . "$HOME/.guix-profile/etc/profile"

export EDITOR=vim
export HISTSIZE=10000
export HISTFILESIZE=100000
export HISTCONTROL=ignoreboth
shopt -s histappend checkwinsize

PS1='\[\033[1;32m\]\u@\h\[\033[0m\] \[\033[1;34m\]\w\[\033[0m\]\$ '

# $GUIX_CONFIG (путь к этому репозиторию) задаёт make-home, #:repo:
# у каждой машины свой.

# Claude Code стоит из стора и физически не может обновить сам себя.
# Без этого он будет пытаться и ругаться при каждом запуске.
# Обновление версии — правкой packages/claude-code.scm, см. README.
export DISABLE_UPDATES=1

# direnv: .envrc проекта (окружение из manifest.scm, переменные) —
# при входе в каталог. direnv ставит home/emacs.scm (он нужен и Emacs).
command -v direnv >/dev/null && eval "$(direnv hook bash)"

# Звонок по окончании долгой команды.
#
# Всё, что выполнялось дольше DY_BELL_SEC секунд, на выходе даёт два
# сигнала: строку в статусбаре tmux («готово: sleep 4 (4с)») и \a.
# Подробности и порядок проверки — в README, раздел «tmux».
# Выключить в текущем шелле: DY_BELL_SEC=0
DY_BELL_SEC=${DY_BELL_SEC:-20}

# Интерактивные программы из сигнала исключены. Меряется время всей
# командной строки, поэтому `vim файл`, в котором просидели три минуты,
# иначе давал бы «готово: vim файл (180с)» — а вы и так смотрели в это
# окно. Сравнивается первое слово команды, без пути.
DY_BELL_SKIP=${DY_BELL_SKIP:-"vim vi nvim emacs emacsclient nano less more man top htop btop watch ssh tmux info bat"}

# Два сигнала, потому что одного мало.
#
# \a — в /dev/tty, а не в stdout: иначе `долгая_команда > log` уронит его
# в лог. Его ловит tmux (красит вкладку) и пробрасывает в локальный
# терминал. Но стоковый st звука не издаёт (bellvolume = 0), он лишь
# помечает своё окно как urgent, и только если оно не в фокусе.
#
# Поэтому второй сигнал — строка в статусбаре tmux. Она видна сразу и
# не зависит ни от терминала, ни от того, в каком окне мы сидим.
#   $1 — код возврата, $2 — сколько секунд, $3 — команда
_dy_bell() {
    printf '\a' >/dev/tty 2>/dev/null || printf '\a'
    [ -n "$TMUX" ] || return 0
    local what="${3:-команда}" mark="готово"
    [ "${1:-0}" -eq 0 ] 2>/dev/null || mark="ошибка ${1}"
    # ## — экранирование: одиночную # display-message примет за формат.
    tmux display-message -d 5000 -- \
        "${mark}: ${what//\#/##} (${2:-?}с)" 2>/dev/null
    return 0
}

# Засечка времени — на PS0, а не на трапе DEBUG.
#
# PS0 bash разворачивает ровно один раз: после того как команда прочитана
# и перед тем как её запустить. На пустой Enter и на содержимое
# PROMPT_COMMAND он не разворачивается — а трап DEBUG срабатывает перед
# КАЖДОЙ простой командой, в том числе перед звеньями PROMPT_COMMAND
# (у нас там ещё и _direnv_hook). С трапом отсчёт стартовал с показа
# приглашения, и в длительность попадало время, пока мы над ним думали,
# — то есть ложные звонки на мгновенных командах.
#
# ${_dy_e:$((...)):0} — способ выполнить арифметику и не напечатать ни
# байта: $(( )) вычисляется самим шеллом (в отличие от $( ), который
# уходит в подоболочку), поэтому присваивание видно в текущем шелле,
# а подстрока нулевой длины от пустой переменной даёт пустой вывод.
_dy_e=
PS0='${_dy_e:$((_dy_started=SECONDS)):0}'

_dy_bell_precmd() {
    local rc=$?   # первой строкой: дальше $? затрётся
    [ -n "$_dy_started" ] || return 0
    local dur=$(( SECONDS - _dy_started ))
    unset _dy_started
    [ "${DY_BELL_SEC:-0}" -gt 0 ] || return 0
    [ "$dur" -ge "$DY_BELL_SEC" ]  || return 0
    # Текст команды берём из history: BASH_COMMAND показал бы только
    # первое звено конвейера. Команда, начатая с пробела, в history не
    # попадает (HISTCONTROL=ignoreboth) — тогда в строке будет предыдущая.
    local n cmd
    read -r n cmd <<< "$(HISTTIMEFORMAT= builtin history 1)"
    # Первое слово без пути: /usr/bin/vim -> vim, sudo vim -> sudo.
    local first=${cmd%% *}
    case " $DY_BELL_SKIP " in *" ${first##*/} "*) return 0 ;; esac
    _dy_bell "$rc" "$dur" "$cmd"
}

PROMPT_COMMAND="_dy_bell_precmd${PROMPT_COMMAND:+; $PROMPT_COMMAND}"

# Позвонить вручную, когда порог не подходит:
#   ding make -j8          — запустить и позвонить
#   make -j8; ding         — то же хвостом
ding() {
    local rc=0 started=$SECONDS
    if [ $# -gt 0 ]; then "$@"; rc=$?; fi
    _dy_bell "$rc" "$(( SECONDS - started ))" "${*:-ding}"
    return $rc
}

# Локальные настройки и СЕКРЕТЫ.
#
# Этот файл (files/bashrc) уезжает в /gnu/store, который читается любым
# пользователем машины, и лежит в git. Токенам и ключам здесь не место.
#
# Под Guix Home секрет bashrc.local расшифровывает home-sops-secrets из
# files/secrets/home.yaml в tmpfs $XDG_RUNTIME_DIR/secrets при старте
# home-shepherd. Самый первый шелл после загрузки может успеть раньше
# расшифровки — тогда -r ложно и файл просто пропускается.
# На чужом дистрибутиве без Guix Home — обычный файл ~/.bashrc.local.
#
#   guix shell sops -- sops files/secrets/home.yaml    # добавить токен
_secret="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/secrets/bashrc.local"
if [ -r "$_secret" ]; then
    . "$_secret"
elif [ -r "$HOME/.bashrc.local" ]; then
    . "$HOME/.bashrc.local"
fi
unset _secret
