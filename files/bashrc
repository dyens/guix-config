# Подключается из home/dyens.scm через home-bash-service-type.
# Правится ЗДЕСЬ, а не в ~/.bashrc — тот станет симлинком в /gnu/store
# и будет read-only.

# Guix профили в PATH
[ -f "$HOME/.guix-profile/etc/profile" ] && . "$HOME/.guix-profile/etc/profile"

export EDITOR=vim
export HISTSIZE=10000
export HISTFILESIZE=100000
export HISTCONTROL=ignoreboth
shopt -s histappend checkwinsize

PS1='\[\033[1;32m\]\u@\h\[\033[0m\] \[\033[1;34m\]\w\[\033[0m\]\$ '

# Быстрый доступ к конфигам, проброшенным с хоста
export GUIX_CONFIG=/mnt/guix-config

# Локальные настройки и СЕКРЕТЫ.
#
# Этот файл (files/bashrc) уезжает в /gnu/store, который читается любым
# пользователем машины, и лежит в git. Токенам и ключам здесь не место.
#
# Сам ~/.bashrc.local приезжает на машину из репозитория guix-secrets
# в зашифрованном виде и раскладывается при guix home reconfigure.
#
# ~/.bashrc.local НЕ управляется Guix Home и не версионируется:
# создаётся руками, chmod 600, живёт только на этой машине.
#
#   touch ~/.bashrc.local && chmod 600 ~/.bashrc.local
#   echo 'export GITLAB_TOKEN=...' >> ~/.bashrc.local
[ -f "$HOME/.bashrc.local" ] && . "$HOME/.bashrc.local"
